#!/bin/sh
set -e   # abort on the first failing command, so a failed check doesn't get treated as a pass

branch=$(git rev-parse --abbrev-ref HEAD)
if [ "$branch" = "main" ]; then
  echo "Direct commits to main are not allowed. Please use a feature branch." >&2
  exit 1
fi

# Stash unstaged changes (keeping the index intact) so the auto-fixers only ever see
# staged content. Without this, a partially staged file (e.g. via `git add -p`) would
# have its unstaged hunks swept into the commit by the `git add -u` below, since that
# stages a file's whole current content, not just the hunks that were originally staged.
stashed=0
if [ -n "$(git diff --name-only)" ]; then
  git stash push --keep-index --quiet -m "pre-commit: unstaged WIP"
  stashed=1
fi
restore_unstaged() {
  [ "$stashed" = 1 ] && git stash pop --quiet
}
trap restore_unstaged EXIT

npm run check                    # biome: lint + auto-fix formatting in src/, test/
npm run --if-present format:md   # prettier: auto-fix markdown (skipped if script absent)
git add -u                       # safe now — only staged content was on disk to sweep in
npm run typecheck                # tsc --noEmit: fail if types don't compile
