#!/bin/sh
set -e   # abort on the first failing command, so a failed check doesn't get treated as a pass

branch=$(git rev-parse --abbrev-ref HEAD)
if [ "$branch" = "main" ]; then
  echo "Direct commits to main are not allowed. Please use a feature branch." >&2
  exit 1
fi

if ! git diff --quiet || [ -n "$(git ls-files --others --exclude-standard)" ]; then
  echo "Error: You have unstaged or untracked changes in your working directory." >&2
  echo "Please stage all changes (e.g., 'git add') or stash/remove them before committing." >&2
  exit 1
fi

npm run typecheck                # tsc --noEmit: fail if types don't compile (read-only, so nothing is touched on failure)
npm run check                    # biome: lint + auto-fix formatting in src/, test/
npm run --if-present format:md   # prettier: auto-fix markdown (skipped if script absent)

git add -u                       # safe now — any tracked file the fixers touch needed reformatting, so it belongs in the commit
